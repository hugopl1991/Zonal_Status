# =============================================================================
# ARQUIVO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" na mesma pasta do docker-compose.yml e ajuste
# os caminhos para o seu sistema antes de executar qualquer serviço.
#
# Atenção (Windows): use barras normais (/) ou barras duplas (\\).
#   Correto:   C:/Users/nome/Downloads/Suprimidas
#   Incorreto: C:\Users\nome\Downloads\Suprimidas
# =============================================================================

# -----------------------------------------------------------------------------
# DIR_TABELAS
# Pasta que contém as tabelas de configuração, como o processamentos.csv
# -----------------------------------------------------------------------------
DIR_TABELAS=C:/Users/lima-/Downloads/Dados_Hugo/Git/ITV_Indicadores_Ecossistemas/Supressão/Docker/Tabela

# -----------------------------------------------------------------------------
# DIR_SUPRIMIDAS
# Pasta raiz montada em /dados dentro do container.
# Deve conter a estrutura abaixo (gerada pelos scripts):
#   Dados/         → rasters de carbono (TAGB_BGB, Csoil), shapefiles, PRODES
#   resultado_*    → Excel e Shapefiles gerados pelos scripts
#   *_log_*.log    → arquivos de log de auditoria
# -----------------------------------------------------------------------------
DIR_SUPRIMIDAS=C:/Users/lima-/Downloads/Suprimidas

# -----------------------------------------------------------------------------
# DIR_MASCARA_PAI
# Pasta PAI que contém o arquivo Compilado.shp (shapefile de máscara da Vale).
# Informe a PASTA, não o arquivo diretamente — o Docker monta a pasta inteira
# em /mascara_dir e os scripts acessam /mascara_dir/Compilado.shp.
# -----------------------------------------------------------------------------
DIR_MASCARA_PAI=C:/Users/lima-/Downloads/Dados_Hugo/Shape

